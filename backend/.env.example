APP_NAME=agro-asistente
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=agro_asistente
# Caracteres especiales en MYSQL_PASSWORD se codifican en la URL; no se imprime el valor.

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

KNOWLEDGE_DIR=../knowledge

CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=agro_knowledge_pmv1

RAG_TOP_K=3
RAG_MIN_SIMILARITY=0.12
CHUNK_SIZE=500

EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=128
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# PMV1: RAG + Ollama + Qwen2.5 (sin fine-tuning).
# El documento del curso cita "Qwen2.5 1.8B". Ollama no publica el tag qwen2.5:1.8b;
# la variante oficial más cercana de Qwen2.5 es qwen2.5:1.5b.
# Instalar: ollama pull qwen2.5:1.5b
GENERATION_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=90

# SENAMHI WIS 2.0 (OGC API, lectura GET sin API key).
SENAMHI_WIS2_BASE_URL=https://wis.senamhi.gob.pe/oapi
SENAMHI_WIS2_COLLECTION=urn:wmo:md:pe-senamhi:synop-hourly
SENAMHI_WIS2_TIMEOUT_SECONDS=20

# Juez RAGAS (evaluación, no es el API de negocio). Por defecto reutiliza Ollama.
# RAGAS_LLM_PROVIDER=ollama
# RAGAS_EMBEDDING_MODEL=
# OPENAI_API_KEY=

CORS_ORIGINS=http://localhost:5173
