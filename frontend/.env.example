# Vacío en desarrollo: Vite reenvía /api y /health al backend local.
# Al compilar para Render, define la URL del backend sin barra final.
# No coloques secretos ni una URL pública de ejemplo.
VITE_API_BASE_URL=

# Destino del proxy de desarrollo (solo local). Predeterminado versionado: 8000.
# Si el backend local corre en 8010, crea frontend/.env.local (ignorado por Git) con:
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8010
# VITE_DEV_PROXY_TARGET=
