# Vacío en desarrollo: Vite reenvía /api y /health al backend local.
# Al compilar para Render, define la URL del backend sin barra final.
# No coloques secretos ni una URL pública de ejemplo.
VITE_API_BASE_URL=
# Almacenamiento de sesión: local | session.
# Vacío: en `vite build` (PROD) usa session; en `vite` (dev) usa local.
# Recomendado en despliegues: session
VITE_AUTH_STORAGE=
# true = no guardar JWT en storage (usar cookie HttpOnly del backend).
# Requiere AUTH_COOKIE_ENABLED=true en el API.
VITE_AUTH_COOKIE_MODE=false
